# ══════════════════════════════════════════════════════════════════════
# REQUIRED for production
# ══════════════════════════════════════════════════════════════════════

# Signs the student/parent/admin session cookie. In production
# (NODE_ENV=production), the app REFUSES TO START without one or the
# ADMIN_PASSWORD below set. Any random 32+ character string.
SESSION_SECRET=

# Admin portal login. Without these, admin login returns a clear "not
# configured" error rather than working — set both if you need the
# admin/school dashboards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ══════════════════════════════════════════════════════════════════════
# OPTIONAL — The app defaults to local file-based storage.
# ══════════════════════════════════════════════════════════════════════

# DATA_DIR — where all app data (database and uploaded files) lives on
# disk. Defaults to ./data. On a production VPS, point this to a
# persistent directory outside your deploy folder (e.g. /var/lib/ai-guru)
# so it persists across redeploys.
DATA_DIR=

# NEXT_PUBLIC_BASE_URL — your real domain once live (e.g. https://your-app.com).
# Only affects a couple of server-generated absolute links.
NEXT_PUBLIC_BASE_URL=

# GEMINI_API_KEY — not needed for this setup, as students use BYOK
# (Bring Your Own Key) stored client-side. Only set if you specifically
# want a server-paid fallback key.
GEMINI_API_KEY=

# Optional separate microservice for higher-accuracy math-equation OCR.
# If unset, the feature is disabled.
MATH_OCR_WORKER_URL=
MATH_OCR_SHARED_SECRET=
