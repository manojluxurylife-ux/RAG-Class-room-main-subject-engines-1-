# AI Guru — environment variables
#
# Copy this file to .env.local for local development (next dev works with
# ZERO of these set — student/parent data just falls back to local JSON
# files under ./data, and the BYOK Gemini flow needs nothing server-side
# at all). Everything below is what's actually needed for a real
# deployment, particularly on Vercel — see the REQUIRED FOR VERCEL block.

# ── REQUIRED FOR VERCEL (or any serverless/read-only-filesystem host) ──
# Vercel's serverless functions can't write to local disk, so student/
# parent/subscription/materials/message/etc. records need a real
# database. Upstash Redis is what this app is wired up for: it's
# serverless (billed per request, no server to run), and Vercel
# provisions it for you — Vercel Dashboard → your project → Storage tab
# → Marketplace → Upstash Redis → Create. Credentials get injected
# automatically; the two names below are what the app looks for
# (it also accepts KV_REST_API_URL/KV_REST_API_TOKEN, which is what some
# Vercel integration flows inject instead — either pair works).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Signs the gg_session cookie (lib/session-sign.ts). Falls back to being
# derived from ADMIN_PASSWORD below if unset — fine for a quick start,
# but set this explicitly in production so rotating ADMIN_PASSWORD
# doesn't also invalidate every signed-in session.
SESSION_SECRET=

# ── Admin portal login ──
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: lets a tester enter any portal without a real account —
# see components/DevBypassBanner.tsx. Leave unset in production.
ADMIN_ENTRY_KEY=

# ── AI ──
# Server-side Gemini key — only spent by a couple of legacy endpoints
# (app/api/ask, app/api/textbook) and gated behind requireStudent(), so
# it's optional if you're running purely on the BYOK (student's own key)
# flow, which is the default (lib/client-ai-router.ts).
GEMINI_API_KEY=
ENABLE_SERVER_AI=
NEXT_PUBLIC_ENABLE_SERVER_AI=

# ── Google Cloud Storage / Drive (study material file persistence) ──
GOOGLE_CLOUD_KEY_JSON=
GOOGLE_SA_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_FOLDER_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Cloud Tasks (background material generation) ──
ADK_TASKS_SERVICE_ACCOUNT=
ADK_WORKER_URL=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=

# ── Misc ──
MATH_OCR_SHARED_SECRET=
MATH_OCR_WORKER_URL=
NEXT_PUBLIC_BASE_URL=
# Only used as a local-dev fallback when Upstash isn't configured — the
# directory json-store.ts/lib/rag/store.ts write their JSON files under.
RAG_DATA_DIR=
